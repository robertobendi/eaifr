# ══════════════════════════════════════════════════════════════
# EAIFR monorepo — environment
# Copy to .env and fill in. Used by docker-compose.yml and by local dev.
# ══════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────
DB_USER=slatestack
DB_PASSWORD=slatestack_dev
DB_NAME=slatestack
DATABASE_URL=postgresql://slatestack:slatestack_dev@localhost:5432/slatestack

# ── Backend (slatestack) ─────────────────────────────────────
# Min 32 chars. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-32-char-random-secret
BETTER_AUTH_URL=http://localhost:3000

ADMIN_EMAIL=admin@eaifr.org
ADMIN_PASSWORD=changeme-please

# Privacy-friendly visitor-hash salt; rotate periodically
METRICS_SALT=replace-with-random-salt

PORT=3000
NODE_ENV=development

# Comma-separated origins allowed by CORS (admin UI + public web)
WEB_ORIGIN=http://localhost:3001,http://localhost:5173

# ── Frontend (web) ───────────────────────────────────────────
# In the browser the site talks to the CMS via this URL
NEXT_PUBLIC_CMS_URL=http://localhost:3000
# Server-side (RSC fetches) uses this — inside docker it's http://api:3000
CMS_URL=http://localhost:3000
WEB_PORT=3001
