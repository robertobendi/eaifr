# EAIFR — Pebblestack-based PHP site

# Per-install state (different on every host).
/data/*.sqlite
/data/*.sqlite-journal
/data/*.sqlite-wal
/data/*.sqlite-shm
/data/installed.lock
/data/cache/

# Static-export output (generated by bin/export.php, deployed to GH Pages).
/dist/

# User uploads — content uploaded via /admin/media. The brand assets
# committed under /uploads/img, /uploads/logos, /uploads/svg ARE checked
# in (they're the design source), so use a per-folder rule rather than
# blanket-ignoring /uploads/*.
/uploads/media/

# Editor / OS clutter.
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Local-only assistant tooling.
.claude/

# Reference-only design source — node_modules of the brochure HTML.
/assets-source/node_modules/

