{% extends '@theme/layout.twig' %}

{% set name     = entry.field('name', entry.slug) %}
{% set short    = entry.field('short', '') %}
{% set accent   = entry.field('accent', 'teal') %}
{% set overview = entry.field('overview', '') %}
{% set cover    = entry.field('cover_image', '') %}
{% if not cover %}
    {% if entry.slug == 'geophysics' or entry.slug == 'physics-of-the-solid-earth' %}{% set cover = '/uploads/img/research-solid-earth.jpg' %}{% endif %}
    {% if entry.slug == 'condensed-matter-physics' %}{% set cover = '/uploads/img/research-condensed-matter.jpg' %}{% endif %}
{% endif %}

{% block title %}{{ name }} · Research · EAIFR{% endblock %}
{% block meta_description %}{{ short }} — {{ overview|striptags|slice(0, 140) }}{% endblock %}

{% block content %}
<section class="page-hero">

    <div class="wrap-narrow detail-hero__inner">

        <h1 class="page-hero__title">{{ name }}</h1>
        {% if short %}
            <p class="page-hero__summary">{{ short }}</p>
        {% endif %}

    </div>
</section>

{% if overview %}
<section class="panel bg-warm section-pad" style="position: relative;">

    <div class="wrap-narrow prose">{{ overview|markdown|raw }}</div>
    <div class="wrap-narrow" style="padding-top: 2.5rem;">
        <a href="/research" class="btn btn-outline">← All research areas</a>
    </div>
</section>
{% endif %}
{% endblock %}
