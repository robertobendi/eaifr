{% extends '@theme/layout.twig' %}

{% block title %}Events · EAIFR{% endblock %}
{% block meta_description %}Schools, conferences, workshops, colloquia, and seminars hosted by EAIFR in Kigali and online.{% endblock %}

{% block content %}
{% include '@theme/partials/page-hero.twig' with {
    eyebrow: 'Events',
    title:   'Conferences, schools,',
    accent:  'workshops.',
    summary: 'EAIFR convenes international scientific gatherings on the African continent — bringing students, researchers and practitioners together around topics of shared interest.',
    tone:    'cream'
} %}

<section class="panel bg-warm section-pad" style="position: relative;">
    <div class="grain"></div>
    <div class="wrap">
        {% if entries|length > 0 %}
            <div style="display: grid; gap: 1.25rem;">
                {% for e in entries %}
                    {% include '@theme/partials/event-card.twig' with { event: e, compact: false } %}
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-state"><p>No events scheduled at the moment.</p></div>
        {% endif %}
    </div>
</section>
{% endblock %}
