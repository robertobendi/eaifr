{% extends '@theme/layout.twig' %}

{% set name      = entry.field('name', entry.slug) %}
{% set summary   = entry.field('summary', '') %}
{% set body      = entry.field('body', '') %}
{% set duration  = entry.field('duration', '') %}
{% set window    = entry.field('application_window', '') %}
{% set apply_url = entry.field('apply_url', '') %}

{% block title %}{{ name }} · Academics · EAIFR{% endblock %}
{% block meta_description %}{{ summary }}{% endblock %}

{% block content %}
<section class="page-hero">

    <div class="wrap-narrow detail-hero__inner">

        <h1 class="page-hero__title">{{ name }}</h1>

        {% if summary %}
            <p class="page-hero__summary">{{ summary }}</p>
        {% endif %}
        <dl style="display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; margin: 1.25rem 0; font-family: var(--font-sans); font-size: .95rem;">
            {% if duration %}
            <div>
                <dt style="font-weight: 700; color: var(--ink);">Duration</dt>
                <dd style="margin: .15rem 0 0;">{{ duration }}</dd>
            </div>
            {% endif %}
            {% if window %}
            <div>
                <dt style="font-weight: 700; color: var(--ink);">Application dates</dt>
                <dd style="margin: .15rem 0 0;">{{ window }}</dd>
            </div>
            {% endif %}
        </dl>
        {% if apply_url %}
            <p style="margin: 1.25rem 0 0;"><a href="{{ apply_url }}" target="_blank" rel="noopener" class="btn btn-teal">Apply →</a></p>
        {% endif %}
    </div>
</section>

{% if body %}
<section class="panel bg-warm section-pad" style="position: relative;">

    <div class="wrap-narrow prose">{{ body|markdown|raw }}</div>
    <div class="wrap-narrow" style="padding-top: 2.5rem;">
        <a href="/academics" class="btn btn-outline">← All programmes</a>
    </div>
</section>
{% endif %}
{% endblock %}
