{% extends '@theme/layout.twig' %}

{% set title   = entry.field('title', entry.slug) %}
{% set eyebrow = entry.field('eyebrow', '') %}
{% set summary = entry.field('summary', '') %}
{% set body    = entry.field('body', '') %}
{% set meta    = entry.field('meta_description', summary) %}

{% block title %}{{ title }} · EAIFR{% endblock %}
{% block meta_description %}{{ meta }}{% endblock %}

{% block content %}
{% include '@theme/partials/page-hero.twig' with {
    eyebrow: eyebrow ?: 'Page',
    title:   title,
    summary: summary,
    narrow:  true
} %}

{% if body or entry.slug == 'contact' or entry.slug == 'apply' %}
<section class="panel bg-warm section-pad" style="position: relative;">

    <div class="{{ entry.slug in ['apply', 'msc-application-guidelines', 'msc-faqs'] ? 'wrap' : 'wrap-narrow' }}">
        {% if entry.slug == 'about' %}
            <figure style="margin: 0 0 3rem; background: #fff; border-radius: 4px; padding: clamp(1rem, 3vw, 2rem); border: 1px solid var(--hairline);">
                <img src="/uploads/logos/governance-partnerships.png" alt="UNESCO, EAIFR, the Government of Rwanda, the University of Rwanda, and ICTP" style="display: block; width: 100%; height: auto;" loading="eager" decoding="async">
            </figure>
        {% endif %}
        {% if entry.slug == 'apply' %}
            {% include '@theme/partials/application-guide.twig' %}
        {% elseif entry.slug in ['msc-application-guidelines', 'msc-faqs'] %}
            {% include '@theme/partials/academic-sections.twig' with { content: body } %}
        {% elseif body and entry.slug == 'about' and '[[steering-committee]]' in body %}
            {% set parts = body|split('[[steering-committee]]', 2) %}
            {% set committee = entries('committee_members', 50)|sort((a, b) => a.field('order', 99) <=> b.field('order', 99)) %}
            <style>
                .committee-grid { display: grid; gap: 1rem; margin: 1.75rem 0 2rem; }
                @media (min-width: 640px) { .committee-grid { grid-template-columns: repeat(2, 1fr); } }
                .committee-card { background: #fff; border-radius: 4px; padding: 1.25rem; border: 1px solid var(--hairline); display: flex; gap: 1rem; align-items: center; }
                .committee-card .avatar { width: 72px; height: 72px; border-radius: 50%; flex-shrink: 0; background: var(--cream); object-fit: cover; object-position: center 20%; }
                .committee-card .avatar.placeholder { display: flex; align-items: center; justify-content: center; font-family: var(--font-serif); font-size: 1.5rem; font-weight: 600; color: var(--teal); background: linear-gradient(180deg, var(--warm), var(--cream)); }
                .committee-card .position { font-family: var(--font-sans); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--teal); margin: 0 0 .3rem; }
                .committee-card h4 { font-family: var(--font-serif); font-weight: 700; font-size: 1.05rem; color: var(--ink); margin: 0; line-height: 1.25; }
                .committee-card .role { font-family: var(--font-sans); font-size: .8rem; line-height: 1.5; color: var(--mid); margin: .3rem 0 0; }
            </style>
            <div class="prose">{{ parts[0]|markdown|raw }}</div>
            <div class="committee-grid">
                {% for m in committee %}
                    {% set photo = m.field('photo', '') %}
                    {% set name = m.field('name', m.slug) %}
                    <div class="committee-card">
                        {% if photo %}
                            <img src="{{ photo }}" alt="" class="avatar" loading="lazy" decoding="async">
                        {% else %}
                            <div class="avatar placeholder" aria-hidden="true">{{ name|replace({'Dr. ': '', 'Prof. ': ''})|first|upper }}</div>
                        {% endif %}
                        <div>
                            <p class="position">{{ m.field('position') == 'chair' ? 'Chair' : 'Member' }}</p>
                            <h4>{{ name }}</h4>
                            {% if m.field('role') %}<p class="role">{{ m.field('role') }}</p>{% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="prose">{{ parts[1]|markdown|raw }}</div>
        {% elseif body %}<div class="prose">{{ body|markdown|raw }}</div>{% endif %}

        {% if entry.slug == 'about' %}
            <div class="prose" style="margin-top: 2rem;">
                <h3>International collaborators</h3>
                <ul>
                    {% for partner in entries('partners', 100) %}
                        {% if partner.field('tier') != 'principal' %}
                            <li>{% if partner.field('url') %}<a href="{{ partner.field('url') }}" target="_blank" rel="noopener">{{ partner.field('name', partner.slug) }}</a>{% else %}{{ partner.field('name', partner.slug) }}{% endif %}</li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {% if entry.slug == 'contact' %}
            <div style="margin-top: {{ body ? '3rem' : '0' }};">
                {% if static_export %}
                    {% include '@theme/partials/contact-mailto.twig' %}
                {% else %}
                    {% include '@theme/partials/contact-form.twig' %}
                {% endif %}
            </div>
        {% endif %}
    </div>
</section>
{% endif %}
{% endblock %}
