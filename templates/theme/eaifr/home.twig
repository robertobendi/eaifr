{% extends '@theme/layout.twig' %}

{% block title %}EAIFR — East African Institute for Fundamental Research{% endblock %}

{% block head %}
<style>
    /* Hero */
    .hero { color: #fff; overflow: hidden; }
    .hero__bg { position: absolute; inset: 0; z-index: -1; }
    .hero__bg img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; opacity: 0.40; filter: saturate(1.15) brightness(0.72); }
    .hero__bg .scrim {
        position: absolute; inset: 0;
        background:
          linear-gradient(180deg, rgba(6,30,47,0.92) 0%, rgba(6,30,47,0.70) 35%, rgba(6,30,47,0.78) 70%, rgba(6,30,47,0.95) 100%),
          linear-gradient(90deg, rgba(6,30,47,0.85) 0%, rgba(6,30,47,0.55) 50%, rgba(6,30,47,0.72) 100%),
          radial-gradient(55% 45% at 88% 15%, rgba(13,128,128,0.30), transparent 65%),
          radial-gradient(45% 50% at 0% 100%, rgba(212,168,67,0.18), transparent 65%);
    }
    .hero__inner { display: grid; gap: 3rem; padding: clamp(4rem, 12vh, 7rem) 0 clamp(3rem, 8vh, 5rem); min-height: clamp(420px, 78vh, 640px); align-content: end; position: relative; }
    @media (min-width: 768px) { .hero__inner { grid-template-columns: 1.5fr 1fr; padding: 9rem 0 7rem; min-height: 720px; gap: 5rem; } }
    .hero h1 { font-family: var(--font-serif); font-weight: 600; letter-spacing: -0.024em; line-height: 1.04; color: #fff; font-size: clamp(2.25rem, 7vw, 5.25rem); margin: 1rem 0 0; }
    .hero h1 em { font-style: italic; color: var(--gold); font-weight: 600; }
    .hero p.lead { max-width: 560px; margin: 2.25rem 0 0; font-family: var(--font-serif); font-size: 1.15rem; line-height: 1.6; color: rgba(255,255,255,0.80); }
    .hero .ctas { margin-top: 2.5rem; display: flex; flex-wrap: wrap; gap: 0.75rem; }
    .hero .greeting { margin-top: 1.5rem; }
    .hero__aside { display: none; align-self: end; }
    @media (min-width: 768px) { .hero__aside { display: block; } }
    .hero__aside .col { border-left: 1px solid rgba(255,255,255,0.15); padding-left: 2rem; position: relative; }
    .hero__aside .col::before { content: ''; position: absolute; left: -5px; top: 0; width: 9px; height: 9px; border-radius: 50%; background: var(--gold); }
    .hero__aside dl { display: flex; flex-direction: column; gap: 1.75rem; margin: 0; }
    .hero__aside dt { font-family: var(--font-sans); font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold); }
    .hero__aside dd { margin: 0.4rem 0 0; font-family: var(--font-serif); color: rgba(255,255,255,0.90); line-height: 1.4; }
    .hero__aside dd .sub { color: rgba(255,255,255,0.60); }
    .hero__aside dd em { font-style: italic; color: rgba(255,255,255,0.95); }

    /* Vision */
    .vision__grid { display: grid; gap: 4rem; }
    @media (min-width: 768px) { .vision__grid { grid-template-columns: 1.15fr 1fr; gap: 6rem; } }
    .vision h2 { font-family: var(--font-serif); font-weight: 600; letter-spacing: -0.024em; font-size: clamp(2.25rem, 4vw, 3.25rem); line-height: 1.05; color: var(--ink); margin-top: 1.25rem; }
    .vision h2 em { font-style: italic; color: var(--teal); font-weight: 600; }
    .vision p.intro { margin-top: 2rem; font-family: var(--font-serif); font-size: 17px; line-height: 1.65; color: var(--mid); max-width: 36rem; }
    .vision__tags { margin-top: 2.5rem; }
    .vision__tags .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.85rem; }
    .vision__list { list-style: none; padding: 0; margin: 2rem 0 0; display: flex; flex-direction: column; gap: 2.25rem; }
    .vision__list li { display: flex; gap: 1.5rem; align-items: flex-start; }
    .vision__list .num { font-family: var(--font-serif); font-weight: 600; font-size: 2.25rem; color: var(--gold); line-height: 1; font-variant-numeric: tabular-nums; flex-shrink: 0; }
    .vision__list .body { border-top: 1px solid rgba(27,40,56,0.10); padding-top: 1rem; font-family: var(--font-serif); font-size: 17px; line-height: 1.55; color: var(--mid); }

    /* Research preview */
    .research__head { display: grid; gap: 2.5rem; align-items: end; margin-bottom: 3.5rem; }
    @media (min-width: 768px) { .research__head { grid-template-columns: 1fr 1.2fr; gap: 5rem; } }
    .research__head h2 { font-family: var(--font-serif); font-weight: 600; letter-spacing: -0.024em; font-size: clamp(2.5rem, 5vw, 3.75rem); margin-top: 1.25rem; }
    .research__head p { font-family: var(--font-serif); font-size: 17px; line-height: 1.65; color: var(--mid); }
    .research__grid { display: grid; gap: 1.75rem; }
    @media (min-width: 600px) { .research__grid { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 600px) { .research__grid.cols-2 { max-width: 1100px; margin: 0 auto; } }
    @media (min-width: 960px) { .research__grid.cols-3 { grid-template-columns: repeat(3, 1fr); } }
    .research-card {
        background: #fff; border-radius: 18px; overflow: hidden;
        box-shadow: 0 1px 0 rgba(27,40,56,0.04), 0 0 0 1px rgba(27,40,56,0.10);
        text-decoration: none; color: var(--mid);
        display: flex; flex-direction: column;
        transition: transform .3s ease, box-shadow .3s ease;
    }
    .research-card:hover { transform: translateY(-4px); box-shadow: 0 30px 60px -25px rgba(13,128,128,0.45); }
    .research-card .cover { aspect-ratio: 16/10; background: linear-gradient(180deg, var(--cream), var(--warm)); position: relative; overflow: hidden; }
    .research-card .cover img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.22,.61,.36,1); }
    @media (prefers-reduced-motion: no-preference) {
        .research-card:hover .cover img { transform: scale(1.05); }
    }
    .research-card .body { padding: 1.75rem; display: flex; flex-direction: column; gap: 1rem; flex: 1; }
    .research-card h3 { font-family: var(--font-serif); font-weight: 600; font-size: 1.5rem; line-height: 1.2; color: var(--ink); margin: 0; }
    .research-card .subtitle { font-family: var(--font-sans); font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.04em; }
    .research-card .preview { font-family: var(--font-serif); font-size: 15.5px; line-height: 1.6; color: var(--mid); margin: 0; }
    .research-card .cta { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.20em; text-transform: uppercase; margin-top: auto; padding-top: 1rem; }
    .research-card.accent-teal   .subtitle, .research-card.accent-teal   .cta { color: var(--teal); }
    .research-card.accent-navy   .subtitle, .research-card.accent-navy   .cta { color: var(--navy); }
    .research-card.accent-forest .subtitle, .research-card.accent-forest .cta { color: var(--forest); }
    .research-card.accent-rust   .subtitle, .research-card.accent-rust   .cta { color: var(--rust); }

    /* Education */
    .edu__grid { display: grid; gap: 3.5rem; }
    @media (min-width: 768px) { .edu__grid { grid-template-columns: 1.1fr 1fr; gap: 5rem; } }
    .edu h2 { font-family: var(--font-serif); font-weight: 600; letter-spacing: -0.024em; font-size: clamp(2.25rem, 4vw, 3.25rem); margin-top: 1.25rem; line-height: 1.05; }
    .edu h2 em { font-style: italic; color: var(--gold); font-weight: 600; }
    .edu p.lead { max-width: 38rem; margin-top: 2rem; font-family: var(--font-serif); font-size: 1.125rem; line-height: 1.65; color: rgba(255,255,255,0.80); }
    .edu__stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr)); gap: 1.25rem; max-width: 30rem; margin-top: 2.25rem; padding-left: 1.25rem; border-left: 1px solid rgba(255,255,255,0.15); }
    .edu__stats dt { font-family: var(--font-sans); font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold); }
    .edu__stats dd { font-family: var(--font-serif); font-weight: 600; font-size: 1.5rem; color: #fff; margin: 0.5rem 0 0; }
    .edu__card {
        background: rgba(20,61,40,0.70); backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.15); border-radius: 22px; padding: 2rem;
        box-shadow: 0 30px 80px -30px rgba(0,0,0,0.6);
    }
    .edu__card h3 { font-family: var(--font-serif); font-weight: 600; font-size: 1.625rem; color: #fff; margin: 0.85rem 0 1rem; line-height: 1.15; }
    .edu__card p { font-family: var(--font-serif); font-size: 15px; line-height: 1.6; color: rgba(255,255,255,0.80); margin: 0; }
    .edu__card dl { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1.75rem; }
    .edu__card dt { font-family: var(--font-sans); font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(255,255,255,0.60); }
    .edu__card dd { font-family: var(--font-serif); font-size: 15px; color: #fff; margin: 0.25rem 0 0; }
    .edu__card .btn { margin-top: 2rem; }
    .edu__card .btn-gold { color: var(--deep-forest); }

    /* Global reach */
    .reach__grid { display: grid; gap: 4rem; align-items: center; }
    @media (min-width: 1024px) { .reach__grid { grid-template-columns: 1fr 1.35fr; gap: 6rem; } }
    .reach h2 { font-family: var(--font-serif); font-weight: 600; letter-spacing: -0.024em; font-size: clamp(2rem, 4vw, 3rem); margin-top: 1.25rem; line-height: 1.05; }
    .reach h2 em { color: var(--teal); font-style: italic; font-weight: 600; }
    .reach p { font-family: var(--font-serif); font-size: 17px; line-height: 1.6; color: var(--mid); margin-top: 1.75rem; max-width: 32rem; }
    .reach__stats { margin-top: 2.5rem; padding-top: 2.5rem; border-top: 1px solid rgba(27,40,56,0.10); display: grid; grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr)); gap: 1.25rem; }
    .reach__stats dt { font-family: var(--font-sans); font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--teal); }
    .reach__stats dd { font-family: var(--font-serif); font-weight: 600; font-size: 2.5rem; color: var(--ink); line-height: 1.05; margin: 0.5rem 0 0; }
    .reach__map { position: relative; aspect-ratio: 16/10; }
    .reach__map img { width: 100%; height: 100%; object-fit: contain; opacity: 0.65; }
    .reach__map .pin { position: absolute; top: 58%; left: 54%; transform: translate(-50%,-50%); width: 12px; height: 12px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 6px rgba(212,168,67,0.20); }
    .reach__map .pin::after {
        content: ''; position: absolute; inset: -6px; border-radius: 50%;
        border: 1.5px solid rgba(212,168,67,0.55);
    }
    @media (prefers-reduced-motion: no-preference) {
        .reach__map .pin::after { animation: pinPulse 2.8s ease-out infinite; }
        @keyframes pinPulse {
            0%   { transform: scale(0.6); opacity: 0.9; }
            70%  { transform: scale(2.2); opacity: 0; }
            100% { transform: scale(2.2); opacity: 0; }
        }
    }
    .reach__map .pin-label { position: absolute; top: 62%; left: 56%; font-family: var(--font-sans); font-size: 10px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.18em; color: rgba(27,40,56,0.7); }

    /* Events & news */
    .en__grid { display: grid; gap: 4rem; }
    @media (min-width: 1024px) { .en__grid { grid-template-columns: 1fr 1fr; } }
    .en h2 { font-family: var(--font-serif); font-weight: 600; letter-spacing: -0.024em; font-size: clamp(1.75rem, 3vw, 2.5rem); margin-top: 1rem; line-height: 1.1; }
    .en .all-link { display: inline-block; margin-top: 1.75rem; font-family: var(--font-sans); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--teal); text-decoration: none; }
    .en .all-link:hover { text-decoration: underline; text-underline-offset: 4px; }
    .en .stack { display: flex; flex-direction: column; gap: 1rem; margin-top: 2rem; }
    .en .empty { background: rgba(255,255,255,0.6); border: 1px dashed rgba(27,40,56,0.15); border-radius: 18px; padding: 2rem; font-style: italic; }

    /* Partners */
    .partners__intro { text-align: center; padding: 0 1rem; }
    .partners__intro p { max-width: 36rem; margin: 1.5rem auto 0; font-family: var(--font-serif); font-size: 17px; line-height: 1.65; color: var(--mid); }
    .partners__principal { background: #fff; border-radius: 18px; padding: 1.75rem 2rem; box-shadow: 0 10px 40px -20px rgba(6,30,47,0.25); border: 1px solid rgba(27,40,56,0.05); display: flex; align-items: center; justify-content: center; max-width: 700px; margin: 1.5rem auto 0; }
    .partners__principal img { max-width: 640px; width: 100%; height: auto; }
    .partners__label { text-align: center; font-family: var(--font-sans); font-size: 10px; font-weight: 900; letter-spacing: 0.30em; text-transform: uppercase; color: rgba(13,128,128,0.80); margin-top: 1.5rem; }
    .partners__supporters-label { color: rgba(74,85,104,0.70); margin-top: 3.5rem; }
    .partners__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem 2rem; max-width: 980px; margin: 1.5rem auto 0; align-items: center; }
    @media (min-width: 640px) { .partners__grid { grid-template-columns: repeat(3, 1fr); } }
    @media (min-width: 1024px) { .partners__grid { grid-template-columns: repeat(5, 1fr); } }
    .partners__grid img { max-height: 70px; max-width: 100%; opacity: 0.85; transition: opacity .2s; filter: grayscale(0.2); }
    .partners__grid a:hover img { opacity: 1; filter: none; }
</style>
{% endblock %}

{% block content %}

{% set areas      = entries('research_areas', 6)            %}
{% set programmes = entries('programmes', 10, 'created_at ASC') %}
{% set msc        = entry('programmes', 'msc-physics') ?? (programmes[0] ?? null) %}
{% set news       = entries('news', 3)   %}
{% set events     = entries('events', 3) %}
{% set partners   = entries('partners', 50) %}
{% set principal_partners = [] %}
{% set supporter_partners = [] %}
{% for p in partners %}
    {% if p.field('tier') == 'principal' %}
        {% set principal_partners = principal_partners|merge([p]) %}
    {% else %}
        {% set supporter_partners = supporter_partners|merge([p]) %}
    {% endif %}
{% endfor %}

{# ─────────────────────────── Hero ─────────────────────────── #}
<section class="hero panel bg-deep-navy">
    <div class="hero__bg">
        <img src="/uploads/img/virunga-pillars.jpg" alt="" fetchpriority="high" decoding="async">
        <div class="scrim"></div>
    </div>
    <div class="grain-dark"></div>
    <div class="dot-grid" style="position: absolute; right: 2rem; top: 2rem;">
        {% for i in 1..16 %}<span></span>{% endfor %}
    </div>
    <div class="dot-grid teal" style="position: absolute; left: 2rem; bottom: 2rem; grid-template-columns: repeat(3, 9px);">
        {% for i in 1..9 %}<span></span>{% endfor %}
    </div>

    <div class="wrap hero__inner">
        <div>
            <p class="eyebrow gold reveal">Est. 2018 · Kigali · UNESCO Cat. II</p>
            <p class="greeting reveal" style="--reveal-delay: .08s;">Murakaza neza · Welcome</p>
            <h1 class="reveal" style="--reveal-delay: .16s;">Excellence in<br><em>basic science</em><br>for Africa.</h1>
            <div class="gold-bar reveal" style="width: 64px; margin-top: 1.75rem; --reveal-delay: .26s;"></div>
            <p class="lead reveal" style="--reveal-delay: .32s;">A young, dynamic hub for higher education and research in basic sciences — a partnership of the Government and University of Rwanda with the Abdus Salam International Centre for Theoretical Physics.</p>
            <div class="ctas reveal" style="--reveal-delay: .40s;">
                <a href="/research" class="btn btn-gold">Our research <span aria-hidden="true">→</span></a>
                <a href="/academics/msc-physics" class="btn btn-ghost">MSc in Physics</a>
            </div>
        </div>
        <aside class="hero__aside reveal" style="--reveal-delay: .5s;">
            <div class="col">
                <dl>
                    <div>
                        <dt>Hosted at</dt>
                        <dd>University of Rwanda<br><span class="sub">College of Science &amp; Technology · Kigali</span></dd>
                    </div>
                    <div>
                        <dt>Status</dt>
                        <dd>UNESCO Category II Institute<br><span class="sub">In partnership with ICTP</span></dd>
                    </div>
                    <div>
                        <dt>Research programmes</dt>
                        <dd><em>Geophysics</em><br><span class="sub">Volcanology &amp; Seismology</span></dd>
                        <dd style="margin-top: 0.85rem;"><em>Condensed matter physics</em><br><span class="sub">Materials &amp; Biophysics</span></dd>
                    </div>
                </dl>
            </div>
        </aside>
    </div>
</section>

{# ─────────────────────────── Vision ─────────────────────────── #}
<section class="panel bg-cream vision section-pad">
    <div class="grain"></div>
    <div class="wrap vision__grid">
        <div class="reveal">
            <p class="eyebrow">Welcome · Murakaza neza</p>
            <h2>A young, dynamic hub for<br><em>basic science in Africa.</em></h2>
            <div class="gold-bar" style="margin-top: 1.5rem;"></div>
            <p class="intro">Established in 2018, EAIFR is a UNESCO Category&nbsp;II institute working in partnership with the Government and University of Rwanda, and the Abdus Salam International Centre for Theoretical Physics (ICTP).</p>
            <div class="vision__tags">
                <p class="eyebrow">What we do</p>
                <div class="tags">
                    <span class="tag">Research</span>
                    <span class="tag navy">Education</span>
                    <span class="tag rust">Conferences</span>
                    <span class="tag forest">Schools</span>
                    <span class="tag purple">Workshops</span>
                </div>
            </div>
        </div>
        <div class="reveal" style="--reveal-delay: .12s;">
            <p class="eyebrow">Our vision</p>
            <ol class="vision__list">
                <li>
                    <span class="num">01</span>
                    <span class="body">Create a community of African scientists in an international network for basic science.</span>
                </li>
                <li>
                    <span class="num">02</span>
                    <span class="body">Address African challenges in natural hazards, energy, climate, materials and health.</span>
                </li>
                <li>
                    <span class="num">03</span>
                    <span class="body">Deliver academic excellence — quality over quantity.</span>
                </li>
            </ol>
        </div>
    </div>
</section>

{# ─────────────────────────── Research preview ─────────────────────────── #}
<section class="panel bg-warm research section-pad">
    <div class="grain"></div>
    <div class="dot-grid teal" style="position: absolute; right: 2.5rem; top: 2.5rem; grid-template-columns: repeat(5, 9px); opacity: 0.7;">
        {% for i in 1..25 %}<span></span>{% endfor %}
    </div>
    <div class="wrap">
        <div class="research__head">
            <div class="reveal">
                <p class="eyebrow">Collaborative</p>
                <h2>Research</h2>
                <div class="gold-bar" style="margin-top: 1.5rem;"></div>
            </div>
            <p class="reveal" style="--reveal-delay: .1s;">A vibrant hub for local and visiting scientists, with a focus on international collaborations across complementary programmes.</p>
        </div>
        {% if areas|length > 0 %}
            <div class="research__grid {{ areas|length == 2 ? 'cols-2' : 'cols-3' }}">
                {% for area in areas %}
                    {% set accent = area.field('accent', 'teal') %}
                    {% set short  = area.field('short', '') %}
                    {% set overview = area.field('overview', '') %}
                    {% set preview = overview|length > 180 ? overview|slice(0, 180) ~ '…' : overview %}
                    {% set cover = area.field('cover_image', '') %}
                    <a class="research-card accent-{{ accent }} reveal" style="--reveal-delay: {{ (loop.index0 * 0.08)|round(2) }}s;" href="/research/{{ area.slug }}">
                        <div class="cover">
                            {% if cover %}<img src="{{ cover }}" alt="" loading="lazy" decoding="async">
                            {% elseif area.slug == 'geophysics' or area.slug == 'physics-of-the-solid-earth' %}
                                <img src="/uploads/img/research-solid-earth.jpg" alt="" loading="lazy" decoding="async">
                            {% elseif area.slug == 'condensed-matter-physics' %}
                                <img src="/uploads/img/research-condensed-matter.jpg" alt="" loading="lazy" decoding="async">
                            {% endif %}
                        </div>
                        <div class="body">
                            <h3>{{ area.field('name', area.slug) }}</h3>
                            {% if short %}<p class="subtitle">{{ short }}</p>{% endif %}
                            {% if preview %}<p class="preview">{{ preview }}</p>{% endif %}
                            <span class="cta">Explore →</span>
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <p style="font-style: italic;">Research areas coming soon.</p>
        {% endif %}
        <div class="reveal" style="margin-top: 3rem;">
            <a href="/research" class="btn btn-teal">Learn more <span aria-hidden="true">→</span></a>
        </div>
    </div>
</section>

{# ─────────────────────────── Education ─────────────────────────── #}
<section class="panel bg-forest edu section-pad">
    <div style="position: absolute; inset: 0; z-index: -1;">
        <img src="/uploads/img/education.jpg" alt="" loading="lazy" decoding="async" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.14; mix-blend-mode: luminosity;">
    </div>
    <div class="grain-dark"></div>
    <div class="dot-grid" style="position: absolute; right: 2rem; top: 2rem;">
        {% for i in 1..16 %}<span></span>{% endfor %}
    </div>
    <div class="wrap edu__grid">
        <div class="reveal">
            <p class="eyebrow gold">Academics · Education</p>
            <h2>Training the next generation of<br><em>African physicists.</em></h2>
            <div class="gold-bar" style="margin-top: 1.5rem;"></div>
            <p class="lead">EAIFR offers graduate-level physics education at the University of Rwanda, with scientific oversight by ICTP. Scholarships are available for admitted African students — covering tuition, stipend, travel and accommodation.</p>
            <dl class="edu__stats">
                <div>
                    <dt>Duration</dt>
                    <dd>{{ msc ? msc.field('duration', '2 yrs') : '2 yrs' }}</dd>
                </div>
                <div>
                    <dt>Language</dt>
                    <dd>English</dd>
                </div>
                <div>
                    <dt>Support</dt>
                    <dd>Funded</dd>
                </div>
            </dl>
        </div>
        <div class="reveal" style="--reveal-delay: .14s;">
            <div class="edu__card">
                <p class="eyebrow gold">Current offer</p>
                <h3>{{ msc ? msc.field('name', 'MSc in Physics') : 'MSc in Physics' }}</h3>
                <p>{{ msc ? msc.field('summary', 'A two-year, English-language master\'s programme at the University of Rwanda, jointly delivered with ICTP.') : 'A two-year, English-language master\'s programme at the University of Rwanda, jointly delivered with ICTP.' }}</p>
                <dl>
                    <div>
                        <dt>Apply by</dt>
                        <dd>{{ msc ? msc.field('application_window', 'Opens each spring') : 'Opens each spring' }}</dd>
                    </div>
                    <div>
                        <dt>Where</dt>
                        <dd>Kigali</dd>
                    </div>
                </dl>
                <a href="/academics/{{ msc ? msc.slug : 'msc-physics' }}" class="btn btn-gold">Programme details →</a>
            </div>
        </div>
    </div>
</section>

{# ─────────────────────────── Global reach ─────────────────────────── #}
<section class="panel bg-cream reach section-pad">
    <div class="grain"></div>
    <div class="wrap reach__grid">
        <div class="reveal">
            <p class="eyebrow">A global network</p>
            <h2>Rooted in Kigali,<br><em>connected worldwide.</em></h2>
            <div class="gold-bar" style="margin-top: 1.25rem;"></div>
            <p>EAIFR collaborates with universities, research centers and funding bodies on four continents — pairing African scientific questions with international expertise, infrastructure and networks.</p>
            <dl class="reach__stats">
                <div>
                    <dt>Countries</dt>
                    <dd>20+</dd>
                </div>
                <div>
                    <dt>Institutions</dt>
                    <dd>40+</dd>
                </div>
                <div>
                    <dt>Est.</dt>
                    <dd>2018</dd>
                </div>
            </dl>
        </div>
        <div class="reach__map reveal" style="--reveal-delay: .12s;">
            <img src="/uploads/svg/world-dots-teal.svg" alt="EAIFR's international collaboration network" loading="lazy" decoding="async">
            <span class="pin"></span>
            <span class="pin-label">Kigali</span>
        </div>
    </div>
</section>

{# ─────────────────────────── Events & News ─────────────────────────── #}
<section class="panel bg-warm en section-pad">
    <div class="grain"></div>
    <div class="wrap en__grid">
        <div class="reveal">
            <p class="eyebrow">Upcoming events</p>
            <h2>Conferences, schools, workshops.</h2>
            <div class="gold-bar" style="margin-top: 1rem;"></div>
            <div class="stack">
                {% if events|length > 0 %}
                    {% for e in events %}
                        {% include '@theme/partials/event-card.twig' with { event: e, compact: true } %}
                    {% endfor %}
                {% else %}
                    <p class="empty">No upcoming events scheduled at the moment.</p>
                {% endif %}
            </div>
            <a href="/events" class="all-link">All events →</a>
        </div>
        <div class="reveal" style="--reveal-delay: .12s;">
            <p class="eyebrow">News &amp; highlights</p>
            <h2>What&rsquo;s happening at EAIFR.</h2>
            <div class="gold-bar" style="margin-top: 1rem;"></div>
            <div class="stack">
                {% if news|length > 0 %}
                    {% for n in news %}
                        {% include '@theme/partials/news-card.twig' with { item: n } %}
                    {% endfor %}
                {% else %}
                    <p class="empty">No news yet — check back soon.</p>
                {% endif %}
            </div>
            <a href="/news" class="all-link">All news →</a>
        </div>
    </div>
</section>

{# ─────────────────────────── Partners ─────────────────────────── #}
<section class="panel bg-cream section-pad-sm" style="padding-bottom: clamp(4rem, 8vw, 8rem);">
    <div class="grain"></div>
    <div class="wrap">
        <div class="partners__intro reveal">
            <p class="eyebrow">Supported by</p>
            <p>EAIFR operates in partnership with UNESCO, ICTP, the University of Rwanda and the Government of Rwanda — with the support of international research institutions.</p>
        </div>

        <p class="partners__label reveal">Principal partners</p>
        <div class="partners__principal reveal" style="--reveal-delay: .08s;">
            <img src="/uploads/logos/principal-logos.png" alt="UNESCO · Government of Rwanda · University of Rwanda · ICTP" loading="lazy" decoding="async">
        </div>

        {% if supporter_partners|length > 0 %}
            <p class="partners__label partners__supporters-label reveal">In collaboration with</p>
            <div class="partners__grid reveal" style="--reveal-delay: .08s;">
                {% for p in supporter_partners %}
                    {% set logo = p.field('logo', '') %}
                    {% set url  = p.field('url', '#') %}
                    <a href="{{ url }}" target="_blank" rel="noopener" title="{{ p.field('name', p.slug) }}">
                        {% if logo %}<img src="{{ logo }}" alt="{{ p.field('name', p.slug) }}" loading="lazy" decoding="async">
                        {% else %}<span style="font-family: var(--font-sans); font-size: 0.875rem; color: var(--mid);">{{ p.field('name', p.slug) }}</span>
                        {% endif %}
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>

{% endblock %}
