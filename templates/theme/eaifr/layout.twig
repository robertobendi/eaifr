<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script>document.documentElement.classList.add('js');</script>
    <title>{% block title %}{{ site.name }} — East African Institute for Fundamental Research{% endblock %}</title>
    {% block meta %}
        <meta name="description" content="{% block meta_description %}A UNESCO Category II institute for basic sciences in Africa. A partnership of the Government and University of Rwanda with ICTP, established in 2018 in Kigali.{% endblock %}">
    {% endblock %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Lato:wght@300;400;700;900&display=swap" rel="stylesheet">
    <link rel="icon" href="/uploads/logos/eaifr-logo.png" type="image/png">
    <style>
        /* ───────────────────────── EAIFR design tokens ─────────────────────────
           Lifted from the print brochure (assets-source/EAIFR_brochure_latest.html). */
        :root {
            --navy:        #0B3D5B;
            --deep-navy:   #061E2F;
            --teal:        #0D8080;
            --bright-teal: #11AAAA;
            --gold:        #D4A843;
            --cream:       #F7F6F2;
            --warm:        #FFFFFF;
            --ink:         #1B2838;
            --mid:         #4A5568;
            --light-ink:   #8CA0B3;
            --forest:      #20603D;
            --deep-forest: #143D28;
            --rust:        #C75C2E;
            --hairline:    rgba(27,40,56,0.10);

            --font-serif: 'Lora', Georgia, 'Times New Roman', serif;
            --font-sans:  'Lato', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            --max:        1200px;
        }

        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; }
        html { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; text-rendering: optimizeLegibility; }
        body {
            font-family: var(--font-serif);
            background: var(--warm);
            color: var(--mid);
            line-height: 1.65;
            font-size: 17px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        a { color: var(--teal); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
        a:hover { color: var(--teal); }
        h1, h2, h3, h4, h5, h6 { font-family: var(--font-serif); color: var(--ink); font-weight: 700; letter-spacing: -0.01em; line-height: 1.15; margin: 0; }
        img { max-width: 100%; height: auto; display: block; }
        hr { border: 0; border-top: 1px solid var(--hairline); margin: 3rem 0; }

        /* ───── Brand primitives ───── */
        .panel { border-top: 1px solid var(--hairline); position: relative; isolation: isolate; }
        .eyebrow {
            display: inline-block;
            font-family: var(--font-sans);
            font-size: 0.6875rem;
            font-weight: 700;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: var(--teal);
            margin: 0;
        }
        .eyebrow.gold  { color: var(--gold); }
        .eyebrow.navy  { color: var(--navy); }
        .eyebrow.rust  { color: var(--rust); }
        .eyebrow.forest { color: var(--forest); }
        .eyebrow.light { color: var(--light-ink); }

        .greeting {
            font-family: var(--font-serif);
            font-style: italic;
            color: var(--gold);
            font-size: 1.375rem;
        }

        .display { font-family: var(--font-serif); font-weight: 600; letter-spacing: -0.024em; line-height: 1.04; }

        /* ───── Layout containers ───── */
        /* .wrap horizontal padding uses !important so it survives when combined with
           classes/inline styles that use `padding: V H` shorthand (which would otherwise
           zero out padding-left/right). Vertical padding is still freely overridable. */
        .wrap        { max-width: var(--max); margin: 0 auto; padding-left: clamp(1rem, 4vw, 2.5rem) !important; padding-right: clamp(1rem, 4vw, 2.5rem) !important; }
        .wrap-narrow { max-width: 800px;     margin: 0 auto; padding-left: clamp(1rem, 4vw, 2.5rem) !important; padding-right: clamp(1rem, 4vw, 2.5rem) !important; }

        /* ───── Header ───── */
        .site-header {
            position: sticky; top: 0; z-index: 50;
            border-bottom: 1px solid var(--hairline);
            background: rgba(255,255,255,0.97);
            backdrop-filter: blur(10px);
        }
        .site-header__inner { display: flex; align-items: center; gap: 1.5rem; padding: 1rem 0; }
        .site-header__logo { display: flex; align-items: center; gap: 0.85rem; text-decoration: none; }
        .site-header__logo img { height: 36px; width: auto; }
        .site-header__title { display: none; font-family: var(--font-sans); font-weight: 700; font-size: 9.5px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--mid); border-left: 1px solid var(--hairline); padding-left: 0.85rem; line-height: 1.5; }
        @media (min-width: 640px) { .site-header__title { display: flex; flex-direction: column; } }
        .site-nav { margin-left: auto; display: none; align-items: center; gap: 0.25rem; }
        @media (min-width: 1200px) { .site-nav { display: flex; } }
        .site-nav a {
            border-radius: 3px; padding: 0.45rem 0.65rem;
            font-family: var(--font-sans); font-weight: 700; font-size: 0.875rem;
            color: rgba(27,40,56,0.7); text-decoration: none; transition: background-color .15s, color .15s;
        }
        .site-nav a:hover { background: rgba(27,40,56,0.06); color: var(--ink); }
        .site-nav a.active { background: rgba(13,128,128,0.10); color: var(--teal); }
        .site-nav .apply {
            margin-left: 0.5rem; padding: 0.55rem 1rem; background: var(--gold); color: var(--deep-navy);
            border-radius: 4px; font-weight: 700;
        }
        .site-nav .apply:hover { background: #c5992f; color: var(--deep-navy); }
        .menu-toggle { margin-left: auto; display: inline-flex; width: 44px; height: 44px; align-items: center; justify-content: center; background: transparent; border: 0; color: var(--ink); cursor: pointer; padding: 0; border-radius: 8px; }
        .menu-toggle:hover { background: rgba(27,40,56,0.06); }
        @media (min-width: 1200px) { .menu-toggle { display: none; } .mobile-nav.open { display: none; } }
        .mobile-nav { border-top: 1px solid var(--hairline); display: none; padding: 0.5rem 0; flex-direction: column; gap: 0.25rem; }
        .mobile-nav.open { display: flex; }
        .mobile-nav a {
            font-family: var(--font-sans); font-weight: 700; font-size: 0.9375rem;
            padding: 0.85rem 0.85rem; border-radius: 6px; color: rgba(27,40,56,0.8); text-decoration: none;
            min-height: 44px; display: flex; align-items: center;
        }
        .mobile-nav a:hover { background: rgba(27,40,56,0.05); color: var(--ink); }
        .mobile-nav a.active { background: rgba(13,128,128,0.10); color: var(--teal); }
        .mobile-nav a.apply { background: var(--gold); color: var(--deep-navy); text-align: center; margin-top: 0.5rem; border-radius: 4px; }

        /* ───── Footer ───── */
        .site-footer { border-top: 4px solid var(--teal); background: var(--deep-navy); color: var(--light-ink); margin-top: auto; }
        .site-footer__grid { display: grid; gap: 2.5rem; padding: 3.5rem 0; grid-template-columns: 1fr; }
        @media (min-width: 600px) { .site-footer__grid { grid-template-columns: repeat(2, 1fr); gap: 2.5rem 2rem; padding: 4rem 0; } }
        @media (min-width: 960px) { .site-footer__grid { grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 3rem; padding: 5rem 0; } }
        .site-footer h3 { font-family: var(--font-serif); font-size: 1.5rem; font-weight: 700; color: #fff; margin: 0.6rem 0 0; }
        .site-footer h3 .accent { color: var(--gold); }
        .site-footer p, .site-footer ul { margin: 0; }
        .site-footer__contact { font-family: var(--font-serif); font-size: 15px; line-height: 1.6; margin-top: 1.25rem; color: var(--light-ink); }
        .site-footer__contact p + p { margin-top: 0.25rem; }
        .site-footer ul { list-style: none; padding: 0; margin-top: 1rem; }
        .site-footer li + li { margin-top: 0.5rem; }
        .site-footer ul a { color: rgba(255,255,255,0.8); text-decoration: none; font-family: var(--font-serif); }
        .site-footer ul a:hover { color: #fff; }
        .site-footer__contact a { color: var(--bright-teal); }
        .site-footer__bottom { border-top: 1px solid rgba(255,255,255,0.10); }
        .site-footer__bottom-inner { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.5rem 0; font-size: 0.8125rem; }
        @media (min-width: 600px) { .site-footer__bottom-inner { flex-direction: row; justify-content: space-between; align-items: center; gap: 1.5rem; } }
        .site-footer__bottom a { color: var(--bright-teal); }

        /* ───── Buttons ───── */
        .btn {
            display: inline-flex; align-items: center; gap: 0.6rem;
            padding: 0.85rem 1.6rem; border-radius: 4px;
            font-family: var(--font-sans); font-weight: 700; font-size: 0.875rem; letter-spacing: 0.02em;
            text-decoration: none; transition: background-color .2s, box-shadow .2s, transform .2s;
        }
        .btn-gold { background: var(--gold); color: var(--deep-navy); }
        .btn-gold:hover { background: #e4b84f; color: var(--deep-navy);  }
        .btn-teal { background: var(--teal); color: #fff; }
        .btn-teal:hover { background: #0b6e6e; color: #fff;  }
        .btn-ghost { border: 1px solid rgba(255,255,255,0.25); color: #fff; background: rgba(255,255,255,0.03); }
        .btn-ghost:hover { background: rgba(255,255,255,0.10); color: #fff; }
        .btn-outline { border: 1px solid var(--teal); color: var(--teal); background: transparent; }
        .btn-outline:hover { background: rgba(13,128,128,0.08); color: var(--teal); }

        /* ───── Sections / panels ───── */
        section.bg-warm     { background: var(--warm); }
        section.bg-cream    { background: var(--cream); }
        section.bg-navy     { background: var(--navy); color: rgba(255,255,255,0.92); }
        section.bg-deep-navy { background: var(--deep-navy); color: rgba(255,255,255,0.92); }
        section.bg-forest   { background: linear-gradient(180deg, var(--deep-forest) 0%, var(--forest) 100%); color: rgba(255,255,255,0.92); }
        section.bg-deep-navy h1, section.bg-deep-navy h2, section.bg-deep-navy h3,
        section.bg-navy h1, section.bg-navy h2, section.bg-navy h3,
        section.bg-forest h1, section.bg-forest h2, section.bg-forest h3 { color: #fff; }

        .section-pad { padding: clamp(2.75rem, 5vw, 4.75rem) 0; }
        .section-pad-sm { padding: clamp(2.5rem, 4vw, 3.5rem) 0; }

        /* ───── Interior masthead ───── */
        .page-hero { overflow: hidden; }
        .page-hero__inner { padding-top: clamp(2.5rem, 5vw, 4rem); padding-bottom: clamp(2.25rem, 4vw, 3.25rem); }
        .page-hero__copy { max-width: 820px; }
        .page-hero__title { font-family: var(--font-serif); font-weight: 600; font-size: clamp(2.1rem, 4.2vw, 3.4rem); line-height: 1.12; letter-spacing: -0.025em; margin: .65rem 0 0; }
        .page-hero__title span { font-style: italic; font-weight: 400; color: var(--navy); }
        .page-hero__summary { font-size: 1.02rem; line-height: 1.65; max-width: 690px; margin: 1rem 0 0; }
        .page-hero--navy .page-hero__title span, .page-hero--deep-navy .page-hero__title span, .page-hero--forest .page-hero__title span { color: var(--gold); }
        .detail-hero__inner { padding-top: clamp(2.5rem, 5vw, 4rem); padding-bottom: clamp(2.25rem, 4vw, 3.5rem); }

        /* ───── Cards ───── */
        .card {
            background: #fff; border-radius: 4px; padding: 1.75rem;
            border: 1px solid var(--hairline);
            display: flex; flex-direction: column; gap: 0.85rem;
            text-decoration: none; color: var(--mid);
            transition: transform .2s ease, box-shadow .2s ease, border-color .2s;
        }
        .card:hover { border-color: rgba(13,128,128,.4); }
        .card h3 { font-family: var(--font-serif); font-size: 1.25rem; font-weight: 700; line-height: 1.3; color: var(--ink); }
        .card:hover h3 { color: var(--teal); }
        .card .meta { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.18em; color: var(--teal); }
        .card p.excerpt { font-size: 15px; line-height: 1.6; color: var(--mid); margin: 0; }
        .card .location { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; color: var(--light-ink); }

        /* Tag pills (for vision tags / event kinds). */
        .tag {
            display: inline-flex; align-items: center; padding: 0.3rem 0.85rem; border-radius: 4px;
            font-family: var(--font-sans); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
            background: rgba(13,128,128,0.10); color: var(--teal);
        }
        .tag.navy   { background: rgba(11,61,91,0.10);  color: var(--navy); }
        .tag.gold   { background: rgba(212,168,67,0.18); color: #8b6e1c; }
        .tag.rust   { background: rgba(199,92,46,0.12);  color: var(--rust); }
        .tag.forest { background: rgba(32,96,61,0.12);   color: var(--forest); }
        .tag.purple { background: rgba(120,85,170,0.12); color: #6b4ea0; }

        /* ───── Prose (rendered markdown bodies) ───── */
        .prose { font-family: var(--font-serif); color: var(--mid); font-size: 17px; line-height: 1.75; }
        .prose h2, .prose h3, .prose h4 { color: var(--ink); margin: 2.25rem 0 0.85rem; }
        .prose h2 { font-size: 1.625rem; }
        .prose h3 { font-size: 1.25rem; }
        .prose p, .prose ul, .prose ol { margin: 0 0 1.1em; }
        .prose ul, .prose ol { padding-left: 1.4rem; }
        .prose li + li { margin-top: 0.35rem; }
        .prose strong { color: var(--ink); }
        .prose a { color: var(--teal); }
        .prose blockquote { border-left: 3px solid var(--gold); padding: 0.25rem 0 0.25rem 1.25rem; color: var(--ink); font-style: italic; margin: 1.5rem 0; }
        .prose code { background: rgba(212,168,67,0.15); color: #6b520f; padding: .125rem .375rem; border-radius: 3px; font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 0.9em; }
        .prose pre { background: var(--deep-navy); color: var(--cream); padding: 1.1rem 1.25rem; border-radius: 8px; overflow-x: auto; font-size: 0.9em; }
        .prose pre code { background: transparent; color: inherit; padding: 0; }

        /* ───── Forms ───── */
        .field { display: flex; flex-direction: column; gap: 0.4rem; }
        .field label { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--mid); }
        .field input, .field textarea, .field select {
            font-family: var(--font-serif); font-size: 1rem; padding: 0.7rem 0.9rem;
            border: 1px solid var(--hairline); background: #fff; border-radius: 8px;
            color: var(--ink); outline: none; transition: border-color .15s, box-shadow .15s;
        }
        .field input:focus, .field textarea:focus, .field select:focus {
            border-color: var(--teal); box-shadow: 0 0 0 3px rgba(13,128,128,0.15);
        }
        .field textarea { min-height: 140px; resize: vertical; }
        .field--hp { position: absolute; left: -9999px; }

        /* ───── 404 + simple flash ───── */
        .empty-state { text-align: center; padding: 5rem 0; color: var(--mid); }
        .empty-state h1 { color: var(--ink); }

        /* ───── A11y / focus / responsive utilities ───── */
        :where(a, button, input, select, textarea, .btn):focus-visible {
            outline: 2px solid var(--teal); outline-offset: 2px; border-radius: 4px;
        }
        [hidden] { display: none !important; }
        .skip-link { position: fixed; top: .5rem; left: 1rem; z-index: 100; padding: .7rem 1rem; background: #fff; transform: translateY(-200%); }
        .skip-link:focus { transform: none; }
        .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
        @media (hover: none) {
            .card:hover, .research-card:hover, .person-card:hover, .pub-row:hover, .prog-card:hover, .research-card-lg:hover { transform: none; }
        }
        @media (max-width: 480px) {
            .btn { padding: 0.75rem 1.25rem; font-size: 0.8125rem; }
            .field input, .field textarea, .field select { padding: 0.65rem 0.8rem; }
        }
        /* Prevent stray horizontal overflow from absolutely-positioned decorations on tiny screens */
        body { overflow-x: clip; }

    </style>
    {% block head %}{% endblock %}
</head>
<body>
    {% include '@theme/partials/header.twig' %}

    <a class="skip-link" href="#main-content">Skip to content</a>
    <main id="main-content">
        {% block content %}{% endblock %}
    </main>

    {% include '@theme/partials/footer.twig' %}

    <script>
        (function () {
            var path = window.location.pathname.replace(/\/$/, '');
            document.querySelectorAll('.site-nav a, .mobile-nav a').forEach(function (link) {
                var target = new URL(link.href).pathname.replace(/\/$/, '');
                var active = path === target || path.indexOf(target + '/') === 0;
                link.classList.toggle('active', active);
                if (active) link.setAttribute('aria-current', 'page');
            });
            var btn = document.querySelector('.menu-toggle');
            var nav = document.querySelector('.mobile-nav');
            if (btn && nav) {
                function setMenu(open) {
                    nav.classList.toggle('open', open);
                    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
                    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
                }
                btn.addEventListener('click', function () { setMenu(!nav.classList.contains('open')); });
                document.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape' && nav.classList.contains('open')) {
                        setMenu(false);
                        btn.focus();
                    }
                });
            }
        })();

    </script>
    {% block scripts %}{% endblock %}
</body>
</html>
