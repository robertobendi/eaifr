{# Reusable page hero. Variables:
   - eyebrow (string)
   - title   (string, plain — first line)
   - accent  (string, optional — italic gold second line)
   - summary (string, optional)
   - tone    ('cream' | 'warm' | 'navy' | 'deep-navy' | 'forest', default 'cream')
#}
{% set tone = tone|default('cream') %}
{% set bg = {
    cream: 'bg-cream',
    warm: 'bg-warm',
    navy: 'bg-navy',
    'deep-navy': 'bg-deep-navy',
    forest: 'bg-forest'
}[tone] %}
{% set on_dark = tone in ['navy', 'deep-navy', 'forest'] %}
<section class="panel {{ bg }}" style="overflow: hidden; position: relative;">
    {% if on_dark %}
        <div class="dot-grid" style="position: absolute; right: 2rem; top: 2rem;">
            {% for i in 1..16 %}<span></span>{% endfor %}
        </div>
        <div class="grain-dark"></div>
    {% else %}
        <div class="grain"></div>
    {% endif %}
    <div class="wrap" style="padding-top: clamp(4rem, 7vw, 7rem); padding-bottom: clamp(3.5rem, 6vw, 6rem); max-width: 980px; position: relative;">
        <p class="eyebrow {{ on_dark ? 'gold' : '' }}">{{ eyebrow }}</p>
        <h1 style="font-family: var(--font-serif); font-weight: 700; font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: 1.1; letter-spacing: -0.01em; margin: 1.25rem 0 0; color: {{ on_dark ? '#fff' : 'var(--ink)' }};">
            {{ title }}
            {% if accent %}<span style="display: block; font-style: italic; font-weight: 400; color: var(--gold);">{{ accent }}</span>{% endif %}
        </h1>
        <div class="gold-bar" style="margin-top: 1.5rem;"></div>
        {% if summary %}
            <p style="font-family: var(--font-serif); font-size: 1.125rem; line-height: 1.65; max-width: 620px; margin: 1.75rem 0 0; color: {{ on_dark ? 'rgba(255,255,255,0.80)' : 'var(--mid)' }};">{{ summary }}</p>
        {% endif %}
    </div>
</section>
