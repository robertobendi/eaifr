<header class="page-hero">
    <div class="{{ narrow|default(false) ? 'wrap-narrow' : 'wrap' }} page-hero__inner">
        <div class="page-hero__copy">
            <h1 class="page-hero__title">{{ title }}{% if accent %} {{ accent }}{% endif %}</h1>
            {% if summary %}
                <p class="page-hero__summary">{{ summary }}</p>
            {% endif %}
        </div>
    </div>
</header>
