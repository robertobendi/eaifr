{# Reusable page hero. Variables:
   - eyebrow (string)
   - title   (string, plain — first line)
   - accent  (string, optional — italic gold second line)
   - summary (string, optional)
   - tone    ('cream' | 'warm' | 'navy' | 'deep-navy' | 'forest', default 'cream')
#}
{% set tone = tone|default('cream') %}
{% set bg = {
    cream: 'bg-cream',
    warm: 'bg-warm',
    navy: 'bg-navy',
    'deep-navy': 'bg-deep-navy',
    forest: 'bg-forest'
}[tone] %}
{% set on_dark = tone in ['navy', 'deep-navy', 'forest'] %}
<section class="panel page-hero {{ bg }}">
    {% if on_dark %}
        <div class="dot-grid" style="position: absolute; right: 2rem; top: 2rem;">
            {% for i in 1..16 %}<span></span>{% endfor %}
        </div>
        <div class="grain-dark"></div>
    {% else %}
        <div class="grain"></div>
    {% endif %}
    <div class="wrap page-hero__inner">
        <p class="eyebrow {{ on_dark ? 'gold' : '' }}">{{ eyebrow }}</p>
        <h1 class="page-hero__title" style="color: {{ on_dark ? '#fff' : 'var(--ink)' }};">
            {{ title }}
            {% if accent %}<span style="display: block; font-style: italic; font-weight: 400; color: var(--gold);">{{ accent }}</span>{% endif %}
        </h1>
        <div class="gold-bar page-hero__rule"></div>
        {% if summary %}
            <p class="page-hero__summary" style="color: {{ on_dark ? 'rgba(255,255,255,0.80)' : 'var(--mid)' }};">{{ summary }}</p>
        {% endif %}
    </div>
</section>
