{% set kind = event.field('kind', 'seminar') %}
{% set kind_tone = {
    school: 'forest',
    conference: 'rust',
    workshop: 'purple',
    colloquium: 'navy',
    seminar: ''
} %}
{% set start = event.field('start_date') %}
{% set ends  = event.field('end_date') %}
{% set cover = event.field('cover_image') %}
<a class="card{{ compact|default(false) ? '' : ' event-record' }}" href="/events/{{ event.slug }}">
    {% if not compact|default(false) %}
    <div class="event-record__media">
        {% if cover %}<img src="{{ cover }}" alt="" loading="lazy" decoding="async">
        {% else %}<span class="event-record__placeholder" aria-hidden="true">{{ start ? start|date('M Y') : 'EAIFR' }}</span>{% endif %}
    </div>
    <div class="event-record__body">
    {% endif %}
    <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
        <span class="tag {{ kind_tone[kind]|default('') }}">{{ kind }}</span>
        {% if start %}
            <span class="meta" style="color: var(--mid);">
                {% if ends and ends != start %}
                    {{ start|date('j M Y') }} — {{ ends|date('j M Y') }}
                {% else %}
                    {{ start|date('j M Y') }}
                {% endif %}
            </span>
        {% endif %}
    </div>
    <h3>{{ event.field('title', event.slug) }}</h3>
    {% if not (compact|default(false)) and event.field('summary') %}
        <p class="excerpt">{{ event.field('summary') }}</p>
    {% endif %}
    {% if event.field('location') %}
        <p class="location">{{ event.field('location') }}</p>
    {% endif %}
    {% if not compact|default(false) %}</div>{% endif %}
</a>
