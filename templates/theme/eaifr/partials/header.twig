{% set current_path = app_request_path|default('') %}
{% set NAV = [
    { href: '/about',        label: 'About'        },
    { href: '/news',         label: 'News'         },
    { href: '/people',       label: 'People'       },
    { href: '/research',     label: 'Research'     },
    { href: '/academics',    label: 'Academics'    },
    { href: '/events',       label: 'Events'       },
    { href: '/publications', label: 'Publications' },
    { href: '/visit',        label: 'Visit'        }
] %}
<header class="site-header">
    <div class="wrap site-header__inner">
        <a href="/" class="site-header__logo" aria-label="EAIFR home">
            <svg class="site-header__mark" viewBox="0 0 1185 467" width="127" height="50" aria-hidden="true">
                <image href="/uploads/logos/governance-partnerships.png" width="1800" height="467" />
            </svg>
            <span class="site-header__title">
                <span>East African Institute</span>
                <span>for Fundamental Research</span>
            </span>
        </a>
        <nav class="site-nav" aria-label="Primary">
            {% for item in NAV %}
                {% set active = current_path == item.href or (current_path starts with item.href ~ '/') %}
                <a href="{{ item.href }}"{% if active %} class="active"{% endif %}{% if active %} aria-current="page"{% endif %}>{{ item.label }}</a>
            {% endfor %}
            <a href="/apply" class="apply">Apply</a>
        </nav>
        <button type="button" class="menu-toggle" aria-label="Open menu" aria-expanded="false">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>
    </div>
    <div class="wrap mobile-nav" aria-label="Mobile primary">
        {% for item in NAV %}
            {% set active = current_path == item.href or (current_path starts with item.href ~ '/') %}
            <a href="{{ item.href }}"{% if active %} class="active"{% endif %}{% if active %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {% endfor %}
        <a href="/apply" class="apply">Apply</a>
    </div>
</header>
