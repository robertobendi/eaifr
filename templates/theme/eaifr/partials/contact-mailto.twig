{# Static-export variant of contact-form.twig — used when EAIFR_STATIC_EXPORT=1.
   GitHub Pages can't host a POST endpoint, so we render a styled mailto card
   instead of the contact form. #}
<div style="display: grid; gap: 1.25rem; max-width: 640px; background: #fff; border-radius: 18px; padding: clamp(1.5rem, 4vw, 2.25rem); box-shadow: 0 1px 0 rgba(27,40,56,0.04), 0 0 0 1px rgba(27,40,56,0.10);">
    <p class="eyebrow">Email us directly</p>
    <h3 style="font-family: var(--font-serif); font-size: 1.5rem; color: var(--ink); margin: 0;">info@eaifr.org</h3>
    <p style="margin: 0; color: var(--mid);">
        We read every message. Please mention your affiliation and topic
        (admissions, research collaboration, visit, press) in the subject line
        so we can route it to the right person.
    </p>
    <div>
        <a href="mailto:info@eaifr.org?subject=EAIFR%20inquiry" class="btn btn-teal">Open your email client →</a>
    </div>
</div>
