{% extends '@theme/layout.twig' %}

{% block title %}News · EAIFR{% endblock %}
{% block meta_description %}Latest posts from ICTP-EAIFR on X.{% endblock %}

{% block content %}
{% include '@theme/partials/page-hero.twig' with {
    eyebrow: 'News from ICTP-EAIFR',
    title:   'Latest from',
    accent:  '@ictpeaifr.',
    summary: 'Follow the official ICTP-EAIFR account for announcements, events and research highlights.',
    tone:    'cream'
} %}

<section class="panel bg-warm section-pad" style="position: relative;">
    <div class="grain"></div>
    <div class="wrap-narrow" style="position: relative;">
        {% set x_posts = [] %}
        {% for item in entries %}
            {% if item.field('source_url') %}
                {% set x_posts = x_posts|merge([item]) %}
            {% endif %}
        {% endfor %}
        {% if x_posts %}
            <div class="cards-grid">
                {% for item in x_posts %}
                    {% set published = item.field('published_at') %}
                    <a class="card" href="{{ item.field('source_url') }}" target="_blank" rel="noopener">
                        {% if published %}<time datetime="{{ published|date('c') }}" class="meta">{{ published|date('j F Y') }} · X</time>{% endif %}
                        <h3>{{ item.field('title') }}</h3>
                        <p class="excerpt">{{ item.field('excerpt') }}</p>
                        <span class="all-link">View post on X ↗</span>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <p>Latest posts are being refreshed. <a href="https://x.com/ictpeaifr" target="_blank" rel="noopener">View @ictpeaifr on X ↗</a></p>
        {% endif %}
    </div>
</section>
{% endblock %}
